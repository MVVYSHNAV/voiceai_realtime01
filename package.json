{
  "name": "voice-agent",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "cd client && bun run dev",
    "dev:server": "cd server && bun run dev",
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "generate-tool": "cd client && bun run generate-tool"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
} 
